# Salin menjadi .env (jangan di-commit). Semua nilai di bawah adalah contoh.

PORT=4000
NODE_ENV=development

# Origin yang boleh memanggil API (dipisah koma)
CORS_ORIGINS=http://localhost:3000
# Origin halaman admin NTD (proyek terpisah)
ADMIN_ORIGINS=http://localhost:5173

# PostgreSQL. Kosongkan untuk memakai penyimpanan memori (hanya untuk coba-coba; data admin hilang saat restart).
# Contoh lokal: docker compose up -d db
DATABASE_URL=postgres://ntd:ntd@localhost:5432/ntd

# Sumber data: "fixture" (offline, data dummy sama dengan GUI) atau "http" (Commute Data API sungguhan)
COMMUTE_SOURCE=fixture
COMMUTE_API_BASE_URL=https://api.commute.shiorilabs.id
COMMUTE_API_KEY=
COMMUTE_TIMEOUT_MS=8000
# Khusus COMMUTE_SOURCE=http. Kosong = semua operator (KCI,MRTJ,LRTJ,LRTJBDB,APCGK,TJ) dan wilayah CGK.
# Halte/stasiun operator yang dikeluarkan tetap tampil dengan namanya bila dilewati rute dari API.
COMMUTE_OPERATORS=
COMMUTE_REGIONS=

# Kunci LLM dan token X sebaiknya diisi dari halaman admin (Pengaturan): tersimpan TERENKRIPSI di basis data (kunci turunan
# ADMIN_TOKEN_SECRET, wajib diisi), berlaku tanpa restart, dan tidak pernah dikirim ke browser. Nilai di bawah hanya cadangan:
# dipakai bila admin belum mengisi.
#
# LLM untuk mode LLM (agent navigasi, narasi notifikasi, dan agent pembaca informasi layanan). Tanpa kunci, hanya
# pipeline default (notifikasi template) yang tersedia. Admin menyalakan/mematikan mode LLM di Pengaturan (llmEnabled).
# LLM_PROVIDER: claude | gpt | none
LLM_PROVIDER=claude
LLM_API_KEY=
# Kosongkan untuk default (claude-opus-5-5). Wajib diisi bila LLM_PROVIDER=gpt.
LLM_MODEL=
LLM_TIMEOUT_MS=15000

# Agent pembaca informasi layanan dari akun X operator (gangguan, keterlambatan, penutupan).
# SERVICE_INFO_SOURCE: none (bawaan, tanpa pembacaan otomatis) | x (X API resmi, BERBAYAR per postingan) | fixture (berkas JSON, untuk uji)
# Kosong = "x" bila X_API_BEARER_TOKEN diisi, selain itu "none". Input manual admin selalu bisa tanpa sumber ini.
# Akun yang dibaca, interval, dan anggaran bulanan diatur admin (PUT /api/admin/ai/reader); pembacaan bawaan mati.
SERVICE_INFO_SOURCE=
# Bearer token aplikasi X (app-only) dari console.x.com. Rahasia: jangan di-commit.
X_API_BEARER_TOKEN=
X_API_BASE_URL=
X_API_TIMEOUT_MS=10000
# Untuk SERVICE_INFO_SOURCE=fixture: berkas JSON array [{id, text, createdAt, account, url?}].
SERVICE_INFO_FIXTURE_FILE=

# AI pembaca denah stasiun (admin: "Isi otomatis dari gambar denah"). Bisa ditimpa admin di Pengaturan.
# AI_VISION_PROVIDER: claude | openai (endpoint kompatibel OpenAI Chat Completions: OpenAI, Gemini, OpenRouter, Ollama, ...) | none
AI_VISION_PROVIDER=claude
# Kosong + provider claude = memakai LLM_API_KEY (bila LLM_PROVIDER=claude) atau ANTHROPIC_API_KEY.
AI_VISION_API_KEY=
# Kosongkan untuk default (claude-sonnet-5-5). Wajib diisi bila AI_VISION_PROVIDER=openai.
AI_VISION_MODEL=
# Kosong = endpoint resmi penyedia.
AI_VISION_BASE_URL=
AI_VISION_TIMEOUT_MS=120000

# Admin. ADMIN_TOKEN_SECRET wajib (min. 32 karakter) di production; buat dengan: openssl rand -hex 32
ADMIN_ENABLED=true
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_MINUTES=480
# Admin pertama dibuat otomatis saat basis data belum punya admin. Hapus setelah login pertama.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Pembatasan laju per IP untuk endpoint publik
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
