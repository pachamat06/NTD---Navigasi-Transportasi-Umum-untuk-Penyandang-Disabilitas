# Salin menjadi .env (jangan di-commit). Semua nilai di bawah adalah contoh.

PORT=4000
NODE_ENV=development

# Origin yang boleh memanggil API (dipisah koma)
CORS_ORIGINS=http://localhost:3000
# Origin halaman admin NTD (proyek terpisah)
ADMIN_ORIGINS=http://localhost:5173

# PostgreSQL. Kosongkan untuk memakai penyimpanan memori (hanya untuk coba-coba; data admin hilang saat restart).
# Contoh lokal: docker compose up -d db
DATABASE_URL=postgres://ntd:ntd@localhost:5432/ntd

# Sumber data: "fixture" (offline, data dummy sama dengan GUI) atau "http" (Commute Data API sungguhan)
COMMUTE_SOURCE=fixture
COMMUTE_API_BASE_URL=https://api.commute.shiorilabs.id
COMMUTE_API_KEY=
COMMUTE_TIMEOUT_MS=8000

# LLM untuk menyusun notifikasi. Tanpa kunci, notifikasi memakai template statis.
# LLM_PROVIDER: claude | gpt | none
LLM_PROVIDER=claude
LLM_API_KEY=
# Kosongkan untuk default (claude-opus-5-5). Wajib diisi bila LLM_PROVIDER=gpt.
LLM_MODEL=
LLM_TIMEOUT_MS=15000

# Admin. ADMIN_TOKEN_SECRET wajib (min. 32 karakter) di production; buat dengan: openssl rand -hex 32
ADMIN_ENABLED=true
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_MINUTES=480
# Admin pertama dibuat otomatis saat basis data belum punya admin. Hapus setelah login pertama.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Pembatasan laju per IP untuk endpoint publik
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
