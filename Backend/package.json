{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend NTD: API perencanaan perjalanan aksesibel (Express + TypeScript + PostgreSQL)",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "admin:create": "tsx --env-file-if-exists=.env src/cli.ts admin:create",
    "admin:reset-password": "tsx --env-file-if-exists=.env src/cli.ts admin:reset-password"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "author": ""
}
